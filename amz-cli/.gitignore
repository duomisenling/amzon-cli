# 凭证文件——绝不提交
.env
.env.*
*.env
!.env.example
!.env.local.example

# 本机 Agent、npm 与私有交付配置
/.claude/settings.local.json
/.agents/
/.npmrc
/local-delivery/

# 出口代理:setup.sh 在服务器上生成的配置含代理密码,绝不提交
# (真实的主体↔域名↔出口IP↔密码对照表放 local-delivery/egress-proxy/,上面已整体忽略)
/deploy/egress-proxy/generated/
*.credentials

# 本机生成的 MCP 配置与安装包
/amz-cli-mcp*.json
*.tgz

# 测试/验证跑命令产生的数据(可能含真实店铺数据,绝不提交)
# 约定输出放 local-delivery/verify-output/(上面已忽略整个 local-delivery/);
# 以下为双保险,防止输出落在别处
/verify-output/
/tmp/
*.out.json
*.err.txt
*.err

# 依赖与产物
node_modules/
dist/
*.log
*.tsbuildinfo
coverage/
.nyc_output/

# 系统文件
.DS_Store
Thumbs.db
