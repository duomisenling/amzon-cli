# amz-cli 单个店铺账号模板
#
# 复制并重命名为：
#   %USERPROFILE%\.amz-cli\accounts\<店铺代号>.env
# 店铺代号必须与 MCP account 完全一致，包括大小写。
# 每个店铺文件必须包含该店铺自己的完整凭证和运行设置。
# 不要在本模板中填写真实凭证，也不要提交真实 .env 文件。

# 该店铺自己的 SP-API 应用凭证
LWA_CLIENT_ID=
LWA_CLIENT_SECRET=

# SP-API Refresh Token；未授权区域保持为空。
LWA_REFRESH_TOKEN_NA=
LWA_REFRESH_TOKEN_EU=
LWA_REFRESH_TOKEN_FE=

# Seller ID（Merchant Token）按区域填写。
SELLER_ID_NA=
SELLER_ID_EU=
SELLER_ID_FE=

# SP-API 运行设置；命令明确指定区域时以命令参数为准。
SP_API_REGION=na
SP_API_SANDBOX=false

# 该店铺自己的 Amazon Ads 应用凭证；不使用广告功能可以全部留空。
ADS_CLIENT_ID=
ADS_CLIENT_SECRET=
ADS_REFRESH_TOKEN=

# 未明确指定广告区域时使用的默认端点：na / eu / fe。
ADS_REGION=na
