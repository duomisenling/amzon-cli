# amz-cli 多店铺模板 —— 有几个店铺就复制几份，本文件是「其中一份」的模板
#
# 不要把多个店铺写进同一个文件。每个店铺一份，各自复制并重命名为：
#   %USERPROFILE%\.amz-cli\accounts\<店铺代号>.env
# 例如三个店铺 = accounts\ 下三个文件，运行时用 --account <店铺代号> 切换。
#
# 店铺代号必须与 MCP account 完全一致，包括大小写。
# 每个店铺文件必须自包含：该店铺自己的完整凭证和运行设置，不能依赖主 .env 或别的店铺。
# 不要在本模板中填写真实凭证，也不要提交真实 .env 文件。
#
# （只有一个店铺、且不打算用 --account 的话，用的是另一个模板：.env.local.example，
#   复制到 %USERPROFILE%\.amz-cli\.env。别把两者搞混。）

# 该店铺自己的 SP-API 应用凭证
LWA_CLIENT_ID=
LWA_CLIENT_SECRET=

# SP-API Refresh Token；未授权区域保持为空。
LWA_REFRESH_TOKEN_NA=
LWA_REFRESH_TOKEN_EU=
LWA_REFRESH_TOKEN_FE=

# Seller ID（Merchant Token）按区域填写。
SELLER_ID_NA=
SELLER_ID_EU=
SELLER_ID_FE=

# SP-API 运行设置；命令明确指定区域时以命令参数为准。
SP_API_REGION=na
SP_API_SANDBOX=false

# 该账号的 User-Agent —— 填这个账号所用应用在开发者中心注册的名字和版本，
# 让请求头与注册信息一致。留空则回退通用默认（建议按账号各配一份）。
# 格式参考 SP-API：AppName/Version (Language=Node.js; Platform=Windows)
SP_API_USER_AGENT=
# 广告接口的 UA；留空则复用上面的 SP_API_USER_AGENT。
ADS_USER_AGENT=

# 该店铺自己的 Amazon Ads 应用凭证；不使用广告功能可以全部留空。
ADS_CLIENT_ID=
ADS_CLIENT_SECRET=
ADS_REFRESH_TOKEN=

# 未明确指定广告区域时使用的默认端点：na / eu / fe。
ADS_REGION=na

# ── 代理（可选，按账号配置）──────────────────────────────────────
# 让这个账号的请求通过指定的代理服务器发出
# （企业网络策略、需要固定来源地址等场景）。
#
# 留空 = 直连（行为与没有这项配置时完全一致）。
# 所以"某个账号就是要直连"不需要任何开关，不填即可。
#
# ⚠️ 只写在这里（各账号自己的文件），不要写进共享 .env 或系统环境变量。
#    （切换 --account 时 CLI 会强制清空这三项，所以写错地方也不会串到别的账号。）
#
# 格式：http://用户名:密码@服务器地址:端口
SP_API_PROXY=

# 广告接口专用代理；留空则复用上面的 SP_API_PROXY（通常留空即可）。
ADS_PROXY=

# 出口标签，只写进审计日志用于核对（不含密码）。
EGRESS_LABEL=

# 提示：配好后用 `amz-cli --account <账号> doctor egress` 自检，
# 它会打印实际的出口 IP，并检查代理的目的地限制是否生效。
