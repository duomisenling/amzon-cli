# amz-cli 本地凭证模式模板
#
# 全局安装后，将本文件复制为：
#   Windows: %USERPROFILE%\.amz-cli\.env
#   macOS/Linux: ~/.amz-cli/.env
#
# 这是敏感文件：不要发送到聊天、邮件或 GitHub，不要截图。
# 同事电脑只填写实际需要的店铺和区域；未使用的区域保持为空。
# 本地模式不要填写 BROKER_URL / TEAM_TOKEN / STORE。

# Amazon SP-API 应用凭证
LWA_CLIENT_ID=
LWA_CLIENT_SECRET=

# 按区域填写 Refresh Token：NA=美国/加拿大，EU=英德法意西，FE=远东
LWA_REFRESH_TOKEN_NA=
LWA_REFRESH_TOKEN_EU=
LWA_REFRESH_TOKEN_FE=

# 默认区域：na | eu | fe
SP_API_REGION=na
SP_API_SANDBOX=false

# Seller ID（Merchant Token）也按区域隔离，避免跨区域误用
SELLER_ID_NA=
SELLER_ID_EU=
SELLER_ID_FE=

# Amazon Ads API（不用广告功能可全部留空）
ADS_CLIENT_ID=
ADS_CLIENT_SECRET=
ADS_REFRESH_TOKEN=
ADS_REGION=na

# ── 代理（可选）────────────────────────────────────────────────
# 让请求通过指定的代理服务器发出（企业网络策略、需要固定来源地址等场景）。
#
# 留空 = 直连，行为与没有这项配置时完全一致。
#
# ⚠️ 用了多账号（~/.amz-cli/accounts/<账号>.env）的话，代理要写进**各账号自己的
#    文件**，不要写在这里 —— 写在这里只对不带 --account 的默认账号生效。
#
# 格式：http://用户名:密码@服务器地址:端口
SP_API_PROXY=
# 广告接口专用；留空则复用上面的 SP_API_PROXY。
ADS_PROXY=
# 出口标签，只写进审计日志用于核对（不含密码）。
EGRESS_LABEL=

# 配好后自检：amz-cli doctor egress
# 它会打印实际的出口 IP，并检查代理的目的地限制是否生效。
